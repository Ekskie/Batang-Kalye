config_version=5

[application]

config/name="Batang Kalye"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://scripts/audio/AudioManager.gd"

[batang_kalye]

network/supabase_url="https://edzrwxnsjpljgnzhzwwz.supabase.co"
